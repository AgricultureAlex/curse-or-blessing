  InputLines:
    - '// @ui {"widget":"label", "label":"One row per question. Order here is the full pool — RandomSliceQuestions picks a random subset each round."}'
    - /*
    - "@typedef QuestionEntry"
    - '@property {string} question {"hint":"The word or phrase displayed on screen.", "widget":"text_area"}'
    - '@property {int} correctIdx {"label":"Correct answer: 0 = Curse, 1 = Blessing", "hint":"0 = Curse (tilt right / NO)   1 = Blessing (tilt left / YES)"}'
    - '@property {string} translation {"hint":"Translation or meaning shown after the player answers. Leave empty to skip.", "widget":"text_area"}'
    - '@property {Asset.AudioTrackAsset} audioTrack {"hint":"Pronunciation audio clip for this question. Leave empty to skip audio."}'
    - "*/"
    - "// @input QuestionEntry[] questions"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Score brackets in ascending maxScore order. The lowest bracket whose maxScore >= score is shown."}'
    - /*
    - "@typedef ScoreBracket"
    - '@property {string} text {"hint":"Result text shown on screen. Use {answersMatched} and {questionsAsked} for live numbers.", "widget":"text_area"}'
    - '@property {int} scene {"hint":"Which result prefab slot to activate in ResultsController (0-based index)."}'
    - '@property {int} maxScore {"hint":"Upper score limit for this bracket. Use 1000 for the top bracket."}'
    - "*/"
    - "// @input ScoreBracket[] scoreBrackets"
    - '// @ui {"widget":"separator"}'
    - '// @input Component.AudioComponent audioComponent {"hint":"AudioComponent used to play question audio. Add it to this same SceneObject."}'
    - '// @input float audioDelay = "0" {"hint":"Seconds to wait after the question appears before the audio plays. 0 = immediate."}'
    - '// @ui {"widget":"separator"}'
    - '// @input Component.ScriptComponent translationDisplay {"hint":"A SceneObject with QuestionView.ts (or any IFadeText script) that displays the translation after each answer."}'
